/crates/syntax/                     @parveshgarg
/crates/sema/                       @parveshgarg
/crates/sema_types/                 @parveshgarg
/crates/ir/                         @parveshgarg
/crates/ir_core/                    @parveshgarg
/crates/mono/                       @parveshgarg
/crates/analysis/                   @parveshgarg
/SPEC.md                            @parveshgarg
/docs/GRAMMAR.ebnf                  @parveshgarg

# ---------------------------------------------------------------------------
# Runtime: GC, scheduler, codegen and the runtime C translation units.
# ---------------------------------------------------------------------------
