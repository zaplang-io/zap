        hex.decode("00017f80ff"),
        "a16d257d2dea2fb9719ded81924196e3745b43db155cd655db8fa5666d4dc4a5",
    )
    hmac_case(
        hex.decode(
            "61616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161",
        ),
        hex.decode(
            "6262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262626262",
        ),
        "e17bf2d4d19a9dd7f561f9cf64fc122637736d198eea6455aea5e6c3b4661c34",
    )
    # String inputs retain identical binary output semantics.
    auto text_input = crypto.hmac_sha256_raw("Jefe", "what do ya want for nothing?")
    assert text_input + b"x" == hex.decode("5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843") + b"x"
    # Explicit str streaming input remains accepted by update.
    auto handle = crypto.sha256_new()
    crypto.update(handle, "abc")
    auto text_digest = crypto.digest(handle)
    assert text_digest + b"x" == hex.decode("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") + b"x"
    for count in [-1, 0, 1, 2, 31, 32, 255, 256, 257, 1024]:
        auto result = crypto.random_bytes(count)
        auto size = count if count >= 0 else 0
        assert len(result) == size
        assert result == result[:]
        assert result[:0] == b""
        assert result[:size // 2] + result[size // 2:] == result
        assert result + b"" == result
        auto extended = result + bytes([0, 255])
        assert len(extended) == size + 2
        assert extended[size] == 0 and extended[size + 1] == 255
        assert extended[:size] == result
        assert result != extended
        if size > 0:
            assert result[-1] == result[size - 1]
        list[int64] copied = []
        for i in range(size):
            assert result[i] >= 0 and result[i] <= 255
            copied.append(result[i])
        assert result == bytes(copied)
        assert hex.decode(hex.encode(result)) == result
        auto token = crypto.token_hex(count)
        assert len(token) == size * 2
        assert len(token + "!") == size * 2 + 1
    # Shared call emission must preserve signed count coercion to the C ABI.
    int32 count32 = 3
    assert len(crypto.random_bytes(count32)) == 3
    assert len(crypto.token_hex(count32)) == 6
    int64 count64 = 4
    assert len(crypto.random_bytes(count64)) == 4
    assert len(crypto.token_hex(count64)) == 8
    print("Raw crypto bytes result operations: PASS")
