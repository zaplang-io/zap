# #647: raw crypto results retain bytes on inferred locals, not str-like Ptr.
# Fixed digest/HMAC expected bytes are independently generated with Python's
# hashlib/hmac (OpenSSL-backed). Includes RFC 4231 cases 1, 2 and 6.
# Random output is tested structurally; no probabilistic uniqueness assertions.

def digest_case(
    bytes handle,
    bytes message,
    str empty_hex,
    str expected_hex,
    str extended_hex,
):
    auto initial = crypto.digest(handle)
    assert initial == hex.decode(empty_hex)
    assert initial + b"x" == hex.decode(empty_hex) + b"x"
    auto split = len(message) // 2
    crypto.update(handle, message[:split])
    crypto.update(handle, message[split:])
    auto result = crypto.digest(handle)
    auto expected = hex.decode(expected_hex)
    assert result == expected and result != expected + b"x"
    assert len(result) == len(expected)
    assert result[0] == expected[0] and result[-1] == expected[-1]
    assert result[1:-1] == expected[1:-1]
    assert result[::2] == expected[::2]
    assert result[:8] + result[8:] == expected
    assert result + bytes([0, 255]) == expected + bytes([0, 255])
    assert crypto.digest(handle) == result
    # Hex APIs still return text and support string concatenation.
    auto text = crypto.hexdigest(handle)
    assert text + "!" == expected_hex + "!"
    crypto.update(handle, bytes([0, 255]))
    assert crypto.digest(handle) == hex.decode(extended_hex)
    assert result == expected and initial == hex.decode(empty_hex)

def hmac_case(bytes key, bytes message, str expected_hex):
    auto result = crypto.hmac_sha256_raw(key, message)
    auto expected = hex.decode(expected_hex)
    assert result == expected and len(result) == 32
    assert result[0] == expected[0] and result[-1] == expected[-1]
    assert result[1:-1] == expected[1:-1]
    assert result[::2] == expected[::2]
    assert result[:16] + result[16:] == expected
    assert result + bytes([0, 255]) == expected + bytes([0, 255])
    assert result != expected[:-1]
    assert crypto.hmac_sha256_raw(key, message) == result
    auto text = crypto.hmac_sha256(key, message)
    assert text + "!" == expected_hex + "!"

