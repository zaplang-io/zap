# Golden (#1084): native bigint floor-division and modulo via the word-wise
# long-division kernel (Knuth Algorithm D + single-limb fast path). Pins
# exactness across operand sizes, the Algorithm-D add-back correction, all
# four sign combinations with the floor/modulo identity, limb-boundary and
# mid-limb powers of two, and catchable divide-by-zero. Expected values are
# Python-computed goldens.
def main():
    print("ss_q=" + str(bigint(987654321) // bigint(12345)))
    print("ss_r=" + str(bigint(987654321) % bigint(12345)))
    print("ms_q=" + str(123456789012345678901234567890123456789 // bigint(1000000007)))
    print("ms_r=" + str(123456789012345678901234567890123456789 % bigint(1000000007)))
    print(
        "near_q=" + str(1287149561274489321559106399827761228238019118776869764261461898597289346887060509772979932624022729058243058385902660881960372749946870714857630304584073586 // 429049853758163107186368799942587076079339706258956588087153966199096448962353503257659977541340909686081019461967553627320124249982290238285876768194691195),
    )
    print(
        "near_r=" + str(1287149561274489321559106399827761228238019118776869764261461898597289346887060509772979932624022729058243058385902660881960372749946870714857630304584073586 % 429049853758163107186368799942587076079339706258956588087153966199096448962353503257659977541340909686081019461967553627320124249982290238285876768194691195),
    )
    print(
        "big_q=" + str(2582249878086908589655919172003011874329705792829223512830659356540647622016841194629645353280137831435903171972747493375 // 1180591620717411303431),
    )
    print(
        "big_r=" + str(2582249878086908589655919172003011874329705792829223512830659356540647622016841194629645353280137831435903171972747493375 % 1180591620717411303431),
    )
    print(
        "longdiv_q=" + str(bigint(5) // 1606938044258990275541962092341162602522202993782792835301475),
    )
    print(
        "longdiv_r=" + str(bigint(5) % 1606938044258990275541962092341162602522202993782792835301475),
    )
    print(
        "addback_q=" + str(33607470512262903703135561781567130895 // 52507287660550035351322038002),
    )
    print(
        "addback_r=" + str(33607470512262903703135561781567130895 % 52507287660550035351322038002),
    )
    print(
        "sgn_pp_q=" + str(98765432109876543210987654321098765432 // 123456789012345678901),
    )
    print(
        "sgn_pp_r=" + str(98765432109876543210987654321098765432 % 123456789012345678901),
    )
    print(
        "sgn_pp_id=" + str(98765432109876543210987654321098765432 // 123456789012345678901 * 123456789012345678901 + 98765432109876543210987654321098765432 % 123456789012345678901 - 98765432109876543210987654321098765432),
    )
    print(
        "sgn_pn_q=" + str(98765432109876543210987654321098765432 // (bigint(0) - 123456789012345678901)),
    )
    print(
        "sgn_pn_r=" + str(98765432109876543210987654321098765432 % (bigint(0) - 123456789012345678901)),
    )
    print(
        "sgn_pn_id=" + str(98765432109876543210987654321098765432 // (bigint(0) - 123456789012345678901) * (bigint(0) - 123456789012345678901) + 98765432109876543210987654321098765432 % (bigint(0) - 123456789012345678901) - 98765432109876543210987654321098765432),
    )
    print(
        "sgn_np_q=" + str((bigint(0) - 98765432109876543210987654321098765432) // 123456789012345678901),
    )
    print(
        "sgn_np_r=" + str((bigint(0) - 98765432109876543210987654321098765432) % 123456789012345678901),
    )
    print(
        "sgn_np_id=" + str((bigint(0) - 98765432109876543210987654321098765432) // 123456789012345678901 * 123456789012345678901 + (bigint(0) - 98765432109876543210987654321098765432) % 123456789012345678901 - (bigint(0) - 98765432109876543210987654321098765432)),
    )
    print(
        "sgn_nn_q=" + str((bigint(0) - 98765432109876543210987654321098765432) // (bigint(0) - 123456789012345678901)),
    )
    print(
        "sgn_nn_r=" + str((bigint(0) - 98765432109876543210987654321098765432) % (bigint(0) - 123456789012345678901)),
    )
    print(
        "sgn_nn_id=" + str((bigint(0) - 98765432109876543210987654321098765432) // (bigint(0) - 123456789012345678901) * (bigint(0) - 123456789012345678901) + (bigint(0) - 98765432109876543210987654321098765432) % (bigint(0) - 123456789012345678901) - (bigint(0) - 98765432109876543210987654321098765432)),
    )
    print(
        "by1_q=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 // 1),
    )
    print(
        "by1_r=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 % 1),
    )
    print(
        "bym1_q=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 // (0 - 1)),
    )
    print(
        "bym1_r=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 % (0 - 1)),
    )
    print(
        "zero_q=" + str(0 // 2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905),
    )
    print(
        "zero_r=" + str(0 % 2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905),
    )
    print(
        "eq_q=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 // 2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905),
    )
    print(
        "eq_r=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 % 2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905),
    )
    print(
        "eqneg_q=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 // (bigint(0) - 2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905)),
    )
    print(
        "eqneg_r=" + str(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905 % (bigint(0) - 2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905)),
    )
    print(
        "p2_limb_q=" + str(340282366920938463463374607431768211456 // 18446744073709551616),
    )
    print(
        "p2_limb_r=" + str(340282366920938463463374607431768211456 % 18446744073709551616),
    )
    print("p2_mid_q=" + str(1361129467683753853853498429727072845829 // 8589934592))
    print("p2_mid_r=" + str(1361129467683753853853498429727072845829 % 8589934592))
    print(
        "p2_off_q=" + str(1606938044258990275541962092341162602522202993782792835301376 // 18446744073709551617),
    )
    print(
        "p2_off_r=" + str(1606938044258990275541962092341162602522202993782792835301376 % 18446744073709551617),
    )
    auto den = bigint(
        429049853758163107186368799942587076079339706258956588087153966199096448962353503257659977541340909686081019461967553627320124249982290238285876768194691195,
    )
    auto num = 3 * den + 1
    auto acc = bigint(0)
    for i in range(1000):
        acc = acc + num // den
    print("loop_sum=" + str(acc))
    auto z = bigint(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905) - bigint(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905)
    try:
        auto bad = bigint(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905) // z
        print("divzero_q=NORAISE")
    except ZeroDivisionError:
        print("divzero_q=caught")
    try:
        auto bad2 = bigint(2037035976334486086268445688409378161051468393665936250636142984655581756222139699589808905) % z
        print("divzero_r=NORAISE")
    except ZeroDivisionError:
        print("divzero_r=caught")
