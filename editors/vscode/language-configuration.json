{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:def|class|struct|interface|enum|annotation|decorator|if|elif|else|while|do|for|with|try|except|finally|match|case|scope|select)\\b.*:\\s*(?:#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": ":\\s*(?:#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:else|elif|except|finally|case)\\b.*:\\s*(?:#.*)?$"
  },
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*"
}
