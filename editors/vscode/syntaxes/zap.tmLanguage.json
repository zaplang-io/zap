{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zap",
  "scopeName": "source.zap",
  "patterns": [
    { "include": "#comments" },
    { "include": "#decorators" },
    { "include": "#declarations" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#self" },
    { "include": "#operators" },
    { "include": "#regex" },
    { "include": "#function-call" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.zap",
          "begin": "#",
          "end": "$",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.zap" }
          }
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "match": "(@)\\s*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.zap" },
            "2": { "name": "entity.name.function.decorator.zap" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "function definition: binds the def name",
          "match": "\\b(def)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.zap keyword.declaration.function.zap" },
            "2": { "name": "entity.name.function.zap" }
          }
        },
        {
          "comment": "type-introducing declaration: binds the type name (optional `value` modifier before struct)",
          "match": "\\b(?:(value)\\s+)?(struct|interface|enum|annotation|decorator)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.zap" },
            "2": { "name": "storage.type.zap keyword.declaration.type.zap" },
            "3": { "name": "entity.name.type.zap" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#fstring-triple-double" },
        { "include": "#fstring-triple-single" },
        { "include": "#fstring-double" },
        { "include": "#fstring-single" },
        { "include": "#string-triple-double" },
        { "include": "#string-triple-single" },
        { "include": "#string-double" },
        { "include": "#string-single" }
      ]
    },
    "fstring-triple-double": {
      "name": "string.quoted.triple.double.zap",
      "begin": "\\b(?:[rRbB][fF]|[fF][rRbB]?)\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#fstring-interpolation" }
      ]
    },
    "fstring-triple-single": {
      "name": "string.quoted.triple.single.zap",
      "begin": "\\b(?:[rRbB][fF]|[fF][rRbB]?)'''",
      "end": "'''",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#fstring-interpolation" }
      ]
    },
    "fstring-double": {
      "name": "string.quoted.double.zap",
      "begin": "\\b(?:[rRbB][fF]|[fF][rRbB]?)\"",
      "end": "\"|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#fstring-interpolation" }
      ]
    },
    "fstring-single": {
      "name": "string.quoted.single.zap",
      "begin": "\\b(?:[rRbB][fF]|[fF][rRbB]?)'",
      "end": "'|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [
        { "include": "#string-escape" },
        { "include": "#fstring-interpolation" }
      ]
    },
    "string-triple-double": {
      "name": "string.quoted.docstring.triple.double.zap",
      "begin": "(?:\\b[rRbB]{1,2})?\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [ { "include": "#string-escape" } ]
    },
    "string-triple-single": {
      "name": "string.quoted.docstring.triple.single.zap",
      "begin": "(?:\\b[rRbB]{1,2})?'''",
      "end": "'''",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [ { "include": "#string-escape" } ]
    },
    "string-double": {
      "name": "string.quoted.double.zap",
      "begin": "(?:\\b[rRbB]{1,2})?\"",
      "end": "\"|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [ { "include": "#string-escape" } ]
    },
    "string-single": {
      "name": "string.quoted.single.zap",
      "begin": "(?:\\b[rRbB]{1,2})?'",
      "end": "'|(?<!\\\\)$",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.zap" } },
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.zap" } },
      "patterns": [ { "include": "#string-escape" } ]
    },
    "string-escape": {
      "patterns": [
        {
          "name": "constant.character.escape.zap",
          "match": "\\\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|[0-7]{1,3}|N\\{[^}]+\\}|[\\\\'\"abfnrtv0])"
        }
      ]
    },
    "fstring-interpolation": {
      "patterns": [
        { "name": "constant.character.escape.zap", "match": "\\{\\{|\\}\\}" },
        {
          "name": "meta.embedded.expression.zap",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.zap" } },
          "endCaptures": { "0": { "name": "punctuation.section.embedded.end.zap" } },
          "patterns": [
            { "include": "#numbers" },
            { "include": "#constants" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.zap", "match": "\\b0[xX][0-9A-Fa-f][0-9A-Fa-f_]*\\b" },
        { "name": "constant.numeric.octal.zap", "match": "\\b0[oO][0-7][0-7_]*\\b" },
        { "name": "constant.numeric.binary.zap", "match": "\\b0[bB][01][01_]*\\b" },
        { "name": "constant.numeric.float.zap", "match": "\\b[0-9][0-9_]*\\.[0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?[jJ]?" },
        { "name": "constant.numeric.float.zap", "match": "(?<![\\w.])\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?[jJ]?" },
        { "name": "constant.numeric.float.zap", "match": "\\b[0-9][0-9_]*[eE][+-]?[0-9][0-9_]*[jJ]?\\b" },
        { "name": "constant.numeric.imaginary.zap", "match": "\\b[0-9][0-9_]*[jJ]\\b" },
        { "name": "constant.numeric.integer.zap", "match": "\\b[0-9][0-9_]*\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.zap", "match": "\\b(True|False|None)\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zap",
          "match": "\\b(if|elif|else|while|do|for|in|match|case|break|continue|return|raise|try|except|finally|with|yield|spawn|detached|select|scope)\\b"
        },
        {
          "name": "keyword.control.import.zap",
          "match": "\\b(import|python|as)\\b"
        },
        {
          "name": "keyword.control.concurrency.zap",
          "match": "\\b(channel|close|range)\\b"
        },
        {
          "name": "keyword.operator.word.zap",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "storage.modifier.zap",
          "match": "\\b(const|auto)\\b"
        },
        {
          "name": "storage.type.zap keyword.declaration.zap",
          "match": "\\b(def|struct|interface|enum|annotation|decorator|lambda)\\b"
        },
        {
          "name": "storage.type.function.zap",
          "match": "\\bfn\\b(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.zap",
          "match": "\\b(int32|int64|float32|float64|i32|i64|f32|f64|bool|char|str|bytes|bigint|complex|list|dict|set|heap|array)\\b"
        }
      ]
    },
    "self": {
      "patterns": [
        { "name": "variable.language.self.zap", "match": "\\bself\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.regex.zap", "match": "=~|!~" },
        { "name": "keyword.operator.channel.zap", "match": "<-" },
        { "name": "keyword.operator.assignment.augmented.zap", "match": "(\\+=|-=|\\*=|/=|//=|%=|\\*\\*=|&=|\\|=|\\^=|<<=|>>=|~=)" },
        { "name": "keyword.operator.comparison.zap", "match": "(==|!=|<=|>=|<|>)" },
        { "name": "keyword.operator.arrow.zap", "match": "->" },
        { "name": "keyword.operator.arithmetic.zap", "match": "(\\*\\*|//|[-+*/%])" },
        { "name": "keyword.operator.bitwise.zap", "match": "(<<|>>|[&|^~])" },
        { "name": "keyword.operator.assignment.zap", "match": "=" }
      ]
    },
    "regex": {
      "patterns": [
        {
          "comment": "substitution regex s/pat/rep/flags (common /-delimited form; arbitrary delimiters are not covered)",
          "name": "string.regexp.substitution.zap",
          "match": "\\b(s)(/)((?:\\\\.|[^/\\\\])*)(/)((?:\\\\.|[^/\\\\])*)(/)([a-z]*)",
          "captures": {
            "1": { "name": "storage.type.regex.zap" },
            "2": { "name": "punctuation.definition.regex.begin.zap" },
            "4": { "name": "punctuation.definition.regex.separator.zap" },
            "6": { "name": "punctuation.definition.regex.end.zap" },
            "7": { "name": "keyword.other.regex.flags.zap" }
          }
        },
        {
          "comment": "match regex m/pat/flags (common /-delimited form)",
          "name": "string.regexp.match.zap",
          "match": "\\b(m)(/)((?:\\\\.|[^/\\\\])*)(/)([a-z]*)",
          "captures": {
            "1": { "name": "storage.type.regex.zap" },
            "2": { "name": "punctuation.definition.regex.begin.zap" },
            "4": { "name": "punctuation.definition.regex.end.zap" },
            "5": { "name": "keyword.other.regex.flags.zap" }
          }
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.zap" }
          }
        }
      ]
    }
  }
}
