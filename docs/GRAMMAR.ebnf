(* ======================================================================
   Zap grammar (EBNF) — tracks SPEC.md v0.3 and DECISIONS D-0001..D-0076.
   The Stable 1.0 language surface (#206 / D-0076, docs/STABILITY.md §4.4) is
   frozen; Experimental surfaces (arrays/SIMD, bitfields) are marked at
   their productions. Additions post-freeze are backward-compatible (MINOR).
   (`set` graduated to Stable per #608/#609, D16/D17.)

   This file is load-bearing (I#396): `crates/syntax/tests/grammar.rs` lints it
   (every nonterminal defined, reachable from `module`, no dups, brackets
   balanced) and runs an accept/reject conformance corpus against the real
   hand-written parser. Edits here run in CI's host (no-LLVM) job, so keep the
   grammar well-formed and in step with the parser.

   RSA key-family/padding validation (#642, D-0102) is a stdlib runtime
   contract; it uses the existing call grammar and adds no productions.

   RSA verification DEBUG diagnostics use the existing logging configuration;
   shared RSA validation helpers do not affect call syntax.

   Notation:
     ::=        definition
     |          alternation
     [ x ]      optional (zero or one)
     { x }      repetition (zero or more)
     ( x )      grouping
     "x"        literal terminal
     UPPERCASE  token class produced by the lexer

   Layout tokens are produced by the indentation-sensitive lexer:
     NEWLINE, INDENT, DEDENT, EOF.
   A `block` is `":" NEWLINE INDENT { statement } DEDENT`.
   Inside "(" ")", "[" "]", "{" "}" newlines are insignificant (implicit
   line continuation, D-0041); "\" continues a line; ";" separates simple
   statements on one physical line.
   ====================================================================== *)

module        ::= { NEWLINE } { item } EOF ;

item          ::= function
                | struct_def
                | interface_def
                | enum_def
                | type_alias        (* transparent type alias (#606, D-0105) *)
                | annotation_def
                | decorator_def
                | import
                | cfg_item          (* `when target.*` conditional compilation (I#139) *)
                | statement ;
                  (* The parser accepts a statement here for recovery and AST
                     compatibility, but module linking rejects executable
                     statements (ZAP3016 in the entry module, ZAP3014 in an
                     imported module). A bare module docstring is allowed;
                     see SPEC §2 and D-0090. *)

(* ---------- Decorators & annotations (D-0036) ---------- *)

decorators    ::= { "@" decorator_name [ "(" [ arg_list ] ")" ] NEWLINE } ;
                  (* Built-in decorators include `@on_signal(Signal.X)` (D-0058,
                     ticket #77): on a function, register it as a handler for
                     signal X — no new syntax, it is a decorator with one arg.
                     Field decorators `@default(expr)`, `@validate(...)` and
                     `@range(...)` generate construction-time code (D-0101). *)

decorator_name ::= dotted_name | "range" ;
                  (* `dotted_name`, except the leading segment may be the
                     `range` keyword: the built-in `@range(...)` field decorator
                     (D-0036/D-0101) would otherwise collide with the keyword.
                     Only `range` is allowed; every other keyword stays
                     reserved. *)

(* ---------- Functions (D-0003, D-0038) ---------- *)

function      ::= decorators "def" IDENT [ generics ]
                  "(" [ param_list ] ")" [ "->" type ] block ;

generics      ::= "[" type_param { "," type_param } "]" ;
type_param    ::= IDENT [ ":" type ] ;
                  (* optional interface bound (D-0017/I#154 Fork B); the bound
                     `type` names an interface. Enforced since I#164 (slice 5):
                     each concrete instantiation must structurally satisfy the
                     bound, and the body may call the bound's methods on T (static
                     dispatch). A single bound per parameter is supported;
                     multiple bounds (`T: A + B`) are a deferred follow-up. *)
type_args     ::= "[" type { "," type } "]" ;
                  (* call-site / construction type arguments (I#154 Fork S;
                     generic functions/methods I#161): `Box[str](...)`,
                     `list[T]()`, `identity[int64](x)`, `opt.and_opt[str](o)`. A
                     postfix `[...]` is type_args iff the head resolves to a type,
                     a generic function, or a generic method (an attribute of a
                     value whose type declares that generic method), else a value
                     subscript (`__getitem__`, D-0047); sema/mono classifies it. *)

param_list    ::= [ param { "," param } "/" "," ]
                  [ param { "," param } "," ] [ "*" param { "," param } ]
                | param { "," param } "/" ;
                  (* Two optional bare separators order the parameters (Python
                     semantics). A "/" positional-only separator (#602, D10) makes
                     every parameter BEFORE it positional-only: suppliable only
                     positionally at a call site, never by name. A "*" keyword-only
                     separator (I#496, D-0095) makes every parameter AFTER it
                     keyword-only: suppliable only by name. Each appears at most
                     once; "/" must follow at least one parameter and precede any
                     "*"; "*" must be followed by at least one parameter.
                     Parameters between the two stay positional-or-keyword.
                     Keyword-only parameters may be required or have a default. *)
param         ::= { "@" decorator_name [ "(" [ arg_list ] ")" ] }
                  ( "self"
                  | type "..." IDENT
                  | type "**" IDENT
                  | type IDENT [ "=" expr ] ) ;
                  (* "type ... IDENT" is a positional variadic (D-0038): it
                     collects the extra positional arguments into a `list`.
                     "type ** IDENT" is a keyword-collector (#601): it collects
                     the extra keyword arguments into a `dict[str, type]` (the
                     key is always `str`, the value type is the declared `type`).
                     A collector is the last parameter, appears at most once, and
                     carries neither a default nor the `...` marker.
                     "= expr" is a per-call default.
                     Inline "@name" decorators are parameter annotations
                     (I#458, D-0089): a declared annotation/decorator is
                     reflectable via `reflect_param_annotations`; the
                     parameter binds unchanged.
                     No new syntax for dependency injection (I#466, D-0092): a
                     default of the form "Depends(provider)" on a handler
                     decorated with a registering "@recv.method(...)" is a
                     compile-time marker (recognized by callee name "Depends"),
                     consumed by adapter synthesis before sema and never a
                     runtime value. *)

(* ---------- Structs, interfaces, enums (D-0015, D-0016, D-0018) ---------- *)

struct_def    ::= decorators [ "value" ] "struct" IDENT [ generics ] ":" NEWLINE
                  INDENT { field | function | "pass" NEWLINE } DEDENT ;
                  (* a bare `pass` is the explicit spelling of an empty struct
                     body (#591), mirroring the empty-enum case; declares no
                     field. *)
                  (* "value struct" = opt-in value type (D-0051); plain struct is
                     a reference type (D-0023). "value" is a contextual modifier.
                     Prelude generic structs use this same grammar: `Atomic[T]`
                     (the `sync` atomic cell, I#176/D-0066) is `struct Atomic[T]`
                     whose methods lower to inline LLVM atomics — no new syntax. *)
field         ::= decorators type IDENT [ ":" INT ] [ "=" expr ] NEWLINE ;
                  (* ":" INT is a C-style bitfield width (I#173, D-0068): the
                     field packs into INT bits of the value struct's backing
                     integer. Only on a `value struct`, and then EVERY field must
                     carry a width (v1 does not mix bitfields with full-width
                     fields). The field type must be a fixed-width integer
                     (int32/int64), bool, or a tier-1 enum — never a
                     pointer/reference, so the precise GC never sees packed bits.
                     1 <= INT <= type width; widths of one struct sum to <= 64. *)

interface_def ::= "interface" IDENT [ generics ] ":" NEWLINE
                  INDENT { method_sig } DEDENT ;
method_sig    ::= "def" IDENT "(" [ param_list ] ")" [ "->" type ] NEWLINE ;

enum_def      ::= decorators "enum" IDENT [ generics ] ":" NEWLINE
                  INDENT { enum_member | function | "pass" NEWLINE } DEDENT ;
                  (* tier-1 (all bare constants) -> unboxed int; a data-carrying
                     variant makes the whole enum a tagged value (D-0018/D-0046).
                     `function` = methods on the enum (D-0046); [ generics ] is
                     reserved now, monomorphized when user generics land. *)
type_alias    ::= "type" IDENT [ generics ] "=" type NEWLINE ;
                  (* transparent type alias (#606, D-0105): `type Row = (int64,
                     str)`, or the generic form `type Pair[T] = (T, T)`. The
                     alias is NOT a new nominal type — it resolves to `type` with
                     the same identity, substituting the generic parameters, so
                     the alias and its target are interchangeable. Generic
                     aliases are expanded during monomorphization alongside the
                     D-0017 generics. `type` is a SOFT keyword: it is recognized
                     as the alias introducer only at item start when immediately
                     followed by an identifier, and stays a usable identifier
                     everywhere else. *)

enum_member   ::= variant_name [ "=" expr ] NEWLINE          (* tier-1 constant *)
                | variant_name "(" variant_field { "," variant_field } ")" NEWLINE ;
                  (* tier-3 data-carrying variant; D-0046 *)
variant_name  ::= IDENT | "None" ;
                  (* `None` is a keyword (the null literal) but is also accepted
                     as a variant name — the empty variant of `Optional[T]` and
                     similar sum types (I#154 Fork O, D-0064/D-0065). It is
                     likewise accepted as a member name after `.` (`opt.None`,
                     `case Optional.None:`). *)
variant_field ::= type IDENT ;                               (* type-first, named *)

annotation_def ::= "annotation" IDENT ":" NEWLINE
                  INDENT { field } DEDENT ;

decorator_def ::= "decorator" IDENT [ "(" [ param_list ] ")" ] block ;

(* ---------- Imports (D-0028, D-0012) ---------- *)

import        ::= "import" "python" STRING [ "as" IDENT ] NEWLINE   (* CPython interop, D-0012 *)
                | "import" import_list NEWLINE ;                    (* D-0028, D-0052, D-0081 *)
import_list   ::= import_item { "," import_item }                  (* import a, b as c (no trailing comma) *)
                | "(" import_item { "," import_item } [ "," ] ")" ; (* grouped; trailing comma allowed (I#70) *)
import_item   ::= dotted_name [ "as" IDENT ] ;
                  (* A Zap module resolves to a file: `a` -> <src>/a.zap,
                     `a.b` -> <src>/a/b.zap; a stdlib name is left to the
                     built-in handling (I#283/D-0081). The bound name is the
                     alias, else the path's last segment. Members are accessed
                     qualified (`a.item`); there is no `from a import item`. *)

(* ---------- Types ---------- *)

type          ::= named_type
                | tuple_type
                | func_type ;
named_type    ::= type_name [ type_args ] ;   (* `list[int64]`, `dict[str, V]` *)
type_name     ::= IDENT { "." IDENT }         (* `Point`, or module-qualified
                                                 `mod.Type` (I#283/D-0081) *)
                | TYPE_KEYWORD ;              (* int64, list, dict, array, ... *)
tuple_type    ::= "(" [ type { "," type } ] ")" ;
func_type     ::= "fn" "(" [ type { "," type } ] ")" [ "->" type ] ;
                  (* first-class function value, I#163/D-0067; "fn" is a soft
                     keyword recognized only in type position (followed by "(") *)

(* ---------- Statements ---------- *)

block         ::= ":" NEWLINE INDENT { statement } DEDENT ;

statement     ::= simple_stmt NEWLINE
                | compound_stmt ;

simple_stmt   ::= decl
                | assign
                | aug_assign
                | subst_assign
                | send_stmt                          (* channel send, D-0031 *)
                | "return" [ expr { "," expr } ]     (* bare comma-list -> tuple return, D-0049 *)
                | "raise" [ expr [ "from" expr ] ]   (* "from": explicit cause chain, #604 D-0103 *)
                | "assert" expr [ "," expr ]          (* power-assert; message, D-0054 *)
                | "spawn" [ "detached" ] call_expr   (* "detached": D-0044 *)
                | "break"
                | "continue"
                | "pass"                             (* no-op statement, #591 *)
                | del_stmt                           (* element removal, #595 *)
                | expr ;                       (* ";" may join simple stmts *)
                  (* "pass" is a contextual statement-position word, not a
                     reserved keyword: it is a no-op statement (lowers to no IR)
                     only when it stands alone as a statement (bare `pass`
                     followed by a terminator); in any other position it is an
                     ordinary identifier. It is also the explicit spelling of an
                     empty struct/enum body (see struct_body, enum). *)
                  (* "from" is likewise a contextual word, not a reserved
                     keyword (#604 D-0103): it introduces the cause clause only
                     directly after a raised value in a `raise`; everywhere else
                     it is an ordinary identifier. *)

decl          ::= [ "const" ] ( type | "auto" ) bind_target "=" expr ;  (* D-0003, D-0049 *)
assign        ::= bind_target "=" { bind_target "=" } expr ;
                  (* Chained assignment `a = b = c` (#594): the final `expr` is
                     evaluated EXACTLY ONCE and assigned to every target, left to
                     right (Python semantics). A chained target is an ordinary
                     single-assignment lvalue (name, index, or attribute) and,
                     like a plain assign, must already be a declared binding —
                     chained assignment never introduces a binding (declarations
                     stay type-first / `auto`, D-0003). The zero-repetition case
                     is the ordinary single assignment. *)
aug_assign    ::= target aug_op expr ;
subst_assign  ::= target "~=" subst_regex ;    (* in-place substitution, D-0010 *)
del_stmt      ::= "del" index_target ;
                  (* Element removal `del d[k]` / `del xs[i]` (#595). Scoped to
                     SUBSCRIPT targets: a dict entry removed by key, a list
                     element removed by index — it reuses the collection's own
                     storage operation, so a missing dict key is a no-op (as the
                     non-raising dict read `d[k]` is; real KeyError is #22) and an
                     out-of-range list index raises the same IndexError as a read.
                     Deleting a binding (`del name`) is NOT supported. Like
                     `pass`, `del` is a contextual statement-position word, not a
                     reserved keyword: it is the removal statement only when
                     immediately followed by another identifier, and stays an
                     ordinary identifier everywhere else. *)
index_target  ::= target ;                     (* must resolve to an `atom trailer+` ending in "[" expr "]" *)
aug_op        ::= "+=" | "-=" | "*=" | "/=" | "//=" | "%=" | "**="
                | "&=" | "|=" | "^=" | "<<=" | ">>=" ;
                  (* Operator overloading (D-0047) is semantic, not grammatical:
                     each operator desugars to a dunder method (`a + b` ->
                     `a.__add__(b)`) on a compiler-known operator interface.
                     `aug_op` calls the in-place `__iadd__`-family dunder when
                     the LHS type defines it, else derives from the binary
                     dunder (`a = a.__add__(b)`) — I#61, D-0047/D-0023. *)
target        ::= atom { trailer } ;           (* name, index, slice, attr *)
send_stmt     ::= postfix "<-" expr ;          (* channel send: ch <- v; D-0031 *)

(* ---------- Tuple destructuring targets (D-0049) ---------- *)
bind_target   ::= target                        (* single target *)
                | target_tuple                  (* bare list: a, b *)
                | "(" target_tuple ")" ;        (* parenthesized: (a, b) *)
target_tuple  ::= target_elem { "," target_elem } [ "," ] ;
target_elem   ::= [ "*" ] target                (* at most one "*" per tuple (semantic) *)
                | "(" target_tuple ")" ;        (* nested destructuring *)
                  (* comma-ok receive `auto v, ok = <-ch` is just a bind_target with
                     a `<-ch` receive expr; multiple return destructures a
                     tuple-returning call the same way. *)

compound_stmt ::= if_stmt
                | while_stmt
                | do_while_stmt
                | for_stmt
                | match_stmt
                | try_stmt
                | with_stmt
                | scope_stmt
                | cfg_stmt           (* `when target.*` conditional compilation (I#139) *)
                | select_stmt ;

if_stmt       ::= "if" expr block
                  { "elif" expr block }
                  [ "else" block ] ;

while_stmt    ::= "while" expr block ;

do_while_stmt ::= "do" block "while" expr NEWLINE ;   (* D-0039 *)

for_stmt      ::= "for" target "in" expr block ;
                  (* Iteration is protocol-based, not grammatical (D-0048):
                     `for x in obj` desugars to obj.__iter__() + a comma-ok
                     __next__ -> (T, bool) loop; a __next__ -> T raising
                     StopIteration is also accepted (Python porting). Generators
                     (yield), built-ins, str and channels use the same protocol. *)

try_stmt      ::= "try" block
                  { "except" [ type [ "as" IDENT ] ] block }
                  [ "finally" block ] ;         (* D-0007, D-0029 *)

with_stmt     ::= "with" with_item { "," with_item } block ;  (* D-0027, D-0069 *)
with_item     ::= expr [ "as" IDENT ] ;
                  (* Each manager drives the context-manager protocol
                     __enter__/__exit__ (I#185): __enter__ runs on entry (its
                     result bound by `as`), __exit__ on every exit — normal,
                     early return/break/continue, and panic/unwind. Multiple
                     items nest left-to-right. `with expect_raises(E):` (D-0054)
                     is a test-framework special case. v1 __exit__(self) takes no
                     exception triple and cannot suppress (deferred, gated on
                     typed exceptions I#12). *)

(* ---------- Structured concurrency (D-0044) ---------- *)

scope_stmt    ::= "scope" [ "(" [ arg_list ] ")" ] block ;
                  (* options are keyword args: on_error=OnError.Cancel|Wait;
                     timeout=<int-ms> — a relative deadline in a nonnegative integer
                     number of milliseconds (no unit suffix; D-0094). On expiry the
                     scope cancels its tree and raises `ScopeTimeout` to the caller;
                     0 cancels immediately, a negative value raises ValueError.
                     cancel_on=[Signal.X, ...] — a listed signal cancels the scope
                     tree (D-0058, ticket #77); grace=<ms> — a hard-exit deadline
                     (milliseconds) from the first cancel_on signal or timeout.
                     timeout/on_error/cancel_on are orthogonal. No new syntax: these
                     are ordinary keyword args / a list literal / an int expression.
                     Owns every `spawn` lexically inside; joins/cancels at the dedent,
                     and may raise `ScopeTimeout` (or a child failure / ExceptionGroup)
                     there. `spawn detached` (see simple_stmt) opts out of all scope
                     ownership. *)

(* ---------- Conditional compilation (`when target.*`, I#139 / D-0079) ---------- *)

(* Compile-time conditional compilation: the compiler evaluates each predicate
   against the active build target and keeps only the first matching arm (or the
   `else`), splicing its body into the enclosing scope. The dead arms are parsed
   (so they must be well-formed) but are never name-resolved, type-checked, or
   lowered ("dead-arm skip"), so an arm written for another target does not break
   the build. A `when` block introduces no new scope. `cfg_item` carries a block
   of items (imports/declarations); `cfg_stmt` carries ordinary statement blocks.
   Experimental, additive (D-0076); post-1.0. Boolean combinators are not in v1. *)
cfg_item      ::= "when" cfg_pred item_block
                  { "elif" cfg_pred item_block }
                  [ "else" item_block ] ;
cfg_stmt      ::= "when" cfg_pred block
                  { "elif" cfg_pred block }
                  [ "else" block ] ;
item_block    ::= ":" NEWLINE INDENT { item } DEDENT ;
cfg_pred      ::= "target" "." "arch" "==" "." arch_name
                | "target" "." "os" "==" "." os_name
                | "target" "." "has" "(" "." IDENT ")" ;   (* compile-time feature *)
arch_name     ::= "x86_64" | "aarch64" ;
os_name       ::= "linux" | "windows" | "macos" ;

select_stmt   ::= "select" ":" NEWLINE INDENT { select_case } DEDENT ;  (* D-0031 *)
select_case   ::= "case" select_op block
                | "default" block ;                    (* `default` => non-blocking *)
select_op     ::= IDENT "=" "<-" postfix               (* receive case, binds IDENT *)
                | IDENT "," IDENT "=" "<-" postfix      (* comma-ok receive case *)
                | postfix "<-" expr ;                   (* send case: ch <- v *)

(* ---------- Pattern matching (D-0040) ---------- *)

match_stmt    ::= "match" expr ":" NEWLINE INDENT { case_clause } DEDENT ;
case_clause   ::= "case" pattern [ "if" expr ] block ;

pattern       ::= or_pattern ;
or_pattern    ::= closed_pattern { "|" closed_pattern } ;
closed_pattern ::= "_"
                | literal
                | IDENT                          (* capture: a bare, undotted name binds *)
                | dotted_name                    (* bare value pattern: a qualified
                                                    constant / payload-free variant,
                                                    e.g. `Color.RED`, `Day.SAT`,
                                                    `Shape.Unit`, `Optional.None`. A
                                                    dotted name with no "(" matches by
                                                    value (parser parse_closed_pattern ->
                                                    Pattern with no args; golden
                                                    enum_tier1.zap `case Day.SAT:`). A
                                                    single undotted name is the capture
                                                    above, not a value pattern. *)
                | dotted_name "(" [ pat_arg { "," pat_arg } ] ")"
                | "[" [ seq_pat { "," seq_pat } ] "]"
                | "(" [ pattern { "," pattern } ] ")" ;
seq_pat       ::= "*" [ IDENT ] | pattern ;
pat_arg       ::= IDENT "=" pattern                (* by field name *)
                | pattern ;                        (* positional, decl order; D-0046 *)
                  (* struct- and enum-variant patterns bind fields positionally
                     or by name, developer's choice (D-0040/D-0046). *)

(* ---------- Expressions (lowest to highest precedence) ---------- *)

expr          ::= lambda | yield_expr | ternary ;
lambda        ::= "lambda" [ IDENT { "," IDENT } ] ":" expr ;   (* D-0026 *)
yield_expr    ::= "yield" [ expr ] ;   (* generator suspend; a `def` whose body
                     contains `yield` is a generator returning an Iterator
                     (I#67, D-0026/D-0048). A free function or a struct method
                     may be a generator — a method captures `self` into the state
                     frame (I#429). v1 requires an operand and only supports
                     `yield` in statement position. *)
ternary       ::= or_test [ "if" or_test "else" expr ] ;

or_test       ::= and_test { "or" and_test } ;
and_test      ::= not_test { "and" not_test } ;
not_test      ::= "not" not_test | comparison ;
comparison    ::= bit_or { comp_op bit_or }
                | bit_or ( "=~" | "!~" ) match_regex
                | bit_or "=~" subst_regex ;   (* A run of two or more comp_ops —
                     `a < b < c` — is a Python-style *chained* comparison, NOT
                     left-associative `(a < b) < c`: it means
                     `(a < b) and (b < c) and ...` with each operand evaluated
                     exactly once, left to right, short-circuiting at the first
                     false link (I#386). Parenthesize to defeat chaining. *)
comp_op       ::= "==" | "!=" | "<" | "<=" | ">" | ">=" | "in" | "not" "in" ;
                  (* `not in` (#593) is the negated membership operator, at the
                     same precedence as `in`. `x not in xs` parses and type-
                     checks as, and lowers identically to, `not (x in xs)`
                     (result `bool`). Unlike `in`, it does not chain. *)

bit_or        ::= bit_xor { "|" bit_xor } ;
bit_xor       ::= bit_and { "^" bit_and } ;
bit_and       ::= shift { "&" shift } ;
shift         ::= add { ( "<<" | ">>" ) add } ;
add           ::= term { ( "+" | "-" ) term } ;
term          ::= factor { ( "*" | "/" | "//" | "%" ) factor } ;
factor        ::= ( "+" | "-" | "~" ) factor | power ;
power         ::= postfix [ "**" factor ] ;
postfix       ::= atom { trailer } ;

trailer       ::= "(" [ arg_list ] ")"           (* call *)
                | "[" subscript "]"               (* index or slice *)
                | "." IDENT ;                     (* attribute *)
call_expr     ::= postfix "(" [ arg_list ] ")" ;

subscript     ::= expr
                | [ expr ] ":" [ expr ] [ ":" [ expr ] ] ;  (* slice, D-0030 *)

arg_list      ::= arg { "," arg } ;
arg           ::= [ IDENT "=" ] expr              (* keyword arg, D-0038 *)
                | "*" expr                        (* iterable spread, #597 *)
                | "**" expr ;                     (* mapping spread, #597 *)
                  (* "*expr" unpacks a list/tuple into positional arguments and
                     "**expr" unpacks a `dict[str, V]` into keyword arguments.
                     Python argument order holds: positionals, then "*", then
                     keywords, then "**". A statically-sized tuple expands into
                     fixed parameters; a runtime-length "*list"/"*set" feeds a
                     `type... name` variadic, and "**dict" feeds a `type ** name`
                     collector. *)

atom          ::= literal
                | IDENT
                | "<-" postfix                    (* channel receive, D-0031 *)
                | "(" [ star_elem { "," star_elem } [ "," ] ] ")"  (* grouping / tuple; (e,) = 1-tuple, D-0049 *)
                | list_display
                | brace_display ;

star_elem     ::= expr | "*" expr ;   (* a display element, optionally spliced (#598) *)
                  (* "*expr" splices an iterable's elements in place inside a
                     list/set/tuple display: `[1, *xs, 2]`, `{*a, *b}`,
                     `(x, *rest)`. In a tuple display the operand must be a
                     statically-sized tuple (the result's arity stays known); in
                     a list/set the operand is any iterable. *)

list_display  ::= "[" [ star_elem { "," star_elem } [ "," ] | expr comp_clauses ] "]" ;
brace_display ::= "{" [ dict_items | dict_comp | set_items | expr comp_clauses ] "}" ;
                  (* A "{...}" display is a dict or a set. Empty "{}" is the
                     empty DICT (there is no empty-set literal; build one with
                     a constructor, e.g. set[T]()). A first element followed by
                     ":" (or a leading "**") makes it a dict (dict_items /
                     dict_comp); otherwise it is a set — a set literal (set_items)
                     or a set comprehension (`expr comp_clauses`). Set literals
                     `{1, 2, 3}` and set comprehensions `{x for x in xs}` ship
                     today (parser parse_brace/parse_set_rest produce Expr::Set /
                     Expr::SetComp; goldens set_int.zap, set_str.zap). `set` is
                     Stable (D-0076; graduation #608). *)
dict_items    ::= dict_item { "," dict_item } [ "," ] ;
dict_item     ::= expr ":" expr | "**" expr ;   (* "**expr" merges another dict's entries, last-wins (#598) *)
dict_comp     ::= expr ":" expr comp_clauses ;
set_items     ::= star_elem { "," star_elem } [ "," ] ;
comp_clauses  ::= comp_for { comp_for | comp_if } ;   (* one or more clauses (#599); the first is a "for" *)
comp_for      ::= "for" target "in" expr ;   (* D-0026 *)
comp_if       ::= "if" expr ;   (* filters the clauses to its left (#599) *)

(* ---------- Literals & regex ---------- *)

literal       ::= INT | FLOAT | IMAGINARY | STRING
                | "True" | "False" | "None" ;      (* D-0041 *)

match_regex   ::= "m" DELIM REGEX_BODY DELIM [ FLAGS ] ;        (* D-0010 *)
subst_regex   ::= "s" DELIM REGEX_BODY DELIM REGEX_BODY DELIM [ FLAGS ] ;

dotted_name   ::= IDENT { "." IDENT } ;

(* ----------------------------------------------------------------------
   Lexical tokens (informal — see crates/syntax/src/token.rs and D-0041):

   IDENT      letter/_ followed by letters/digits/_  (leading "_" = private)
   INT        42 | 0x2A | 0o52 | 0b101010   with "_" grouping
   FLOAT      3.14 | .5 | 1. | 1e10 | 1.5e-3
   IMAGINARY  <int|float> "j"
   STRING     '...' | "..." | '''...''' | """...""" with r/b/f (+rb/rf) prefixes
   F_FIELD    inside an f-string (f"...") the content splits into text and
              replacement fields "{" expr [ "!" ("r"|"s"|"a") ] [ ":" spec ] "}"
              ("{{"/"}}" are literal braces); the field expr is a full Zap
              expression, parsed and type-checked like any other (#285, D-0026).
              The field expr may contain string literals that reuse the outer
              delimiter quote (PEP 701, #498): the lexer tracks "{...}" nesting
              so an inner quote inside a field opens a nested string rather than
              ending the f-string (f"{d["k"]}", f'{d.get('k')}'). As in Python
              3.12+, the delimiter quote may NOT be backslash-escaped inside a
              field (f"{d.get(\"k\")}" is rejected): use the unescaped form or
              the other quote. An `Optional[T]` field renders its payload when
              present and "None" when absent (#498), like Python's f"{d.get(k)}".
              spec = [[fill]align][sign]["#"]["0"][width]["." precision][type]
              (Python format mini-language subset; see SPEC §9.3).
   TYPE_KEYWORD  int int32 int64 float float32 float64 i32 i64 f32 f64 bool
                 char str bytes bigint complex list dict set heap array
                 Python-facing scalar synonyms: `int` is the name for the 64-bit
                 signed integer (= int64/i64, I#581 / PR #582) and `float` the
                 name for the 64-bit double (= float64/f64), just as Python's
                 `int`/`float`. Both are resolved as type names by sema, not
                 reserved by the lexer, so they are spelled as IDENT in
                 `type_name` and usable anywhere a type keyword is (`int x = 0`).
   DELIM      a regex delimiter char after m/s (e.g. "/", "{", "!")
   Comments   "#" to end of line. Discarded by the parser, but recoverable as
              trivia for tooling (zap fmt/doc) via tokenize_with_trivia (#225).
   ---------------------------------------------------------------------- *)
